OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEFAULT_MODEL должна поддерживать function-calling (tool use) —
# иначе агент-луп не сможет вызывать инструменты (read_document и т.п.).
# Примеры tool-capable моделей смотрите в каталоге OpenRouter / OPENROUTER_FALLBACK_MODEL в app/config.py.
OPENROUTER_DEFAULT_MODEL=
# OPENROUTER_FALLBACK_MODEL is hardcoded in app/config.py (= google/gemini-2.5-flash), not an env var.

# Active provider: openrouter (default) or zai.
APP_PROVIDER=openrouter

# z.ai (Zhipu / BigModel, GLM) — only required when APP_PROVIDER=zai.
# General API: https://api.z.ai/api/paas/v4
# Coding Plan: https://api.z.ai/api/coding/paas/v4
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# Data-root (ADR-0012): absolute dir holding workspace/, catalog.db,
# prompt_logs/. Defaults to the OS data dir (~/Library/Application
# Support/catalog on macOS, ~/.local/share/catalog otherwise) — unset unless
# you need a custom location.
# APP_DATA_DIR=/absolute/path/to/data
#
# Point overrides (win over APP_DATA_DIR for that one path; mainly for tests
# or advanced setups). Leave unset to use the data-root defaults.
# APP_WORKSPACE=/absolute/path/to/workspace
# APP_DB_PATH=/absolute/path/to/catalog.db

# Prompt logging (для анализа качества ответов)
PROMPT_LOG_ENABLED=false
# PROMPT_LOG_DIR=/absolute/path/to/prompt_logs
