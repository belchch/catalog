OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEFAULT_MODEL должна поддерживать function-calling (tool use) —
# иначе агент-луп не сможет вызывать инструменты (read_document и т.п.).
# Примеры tool-capable моделей смотрите в каталоге OpenRouter / OPENROUTER_FALLBACK_MODEL в app/config.py.
OPENROUTER_DEFAULT_MODEL=
APP_WORKSPACE=workspace
# OPENROUTER_FALLBACK_MODEL is hardcoded in app/config.py (= google/gemini-2.5-flash), not an env var.

# Prompt logging (для анализа качества ответов)
PROMPT_LOG_ENABLED=false
PROMPT_LOG_DIR=workspace/prompt_logs
