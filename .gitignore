# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# Packaged SPA assets (copied into the wheel by the backend build hook)
backend/catalog/static/

# Commit stamp baked into the wheel by the backend build hook
backend/catalog/_build_sha.py

# Env
.env
.env.*
!.env.example

# App data (ADR-0012: lives under the OS data-root / APP_DATA_DIR, outside
# the source tree by default — these rules are a safety net for point
# overrides such as APP_WORKSPACE/PROMPT_LOG_DIR still pointing in-tree).
prompt_logs/
backend/workspace/

# Черновые ревью и заметки, не входящие в публичную документацию
review/
review-*.md

# SQLite databases (local dev/test artifacts)
*.db

# Generated by running `uv` locally against the backend — the backend builds
# with setuptools/pip (no [tool.uv] in backend/pyproject.toml), so this is a
# stray local artifact, not a project lockfile.
backend/uv.lock

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Kilo local state (plans may contain secrets like API tokens)
.kilo/plans/
.kilo/worktrees/

# Cursor pipeline state (local orchestrator state, not shared via git)
.cursor/state/
.cursor/steps-results/

# Claude pipeline state (local orchestrator state, not shared via git)
.claude/state/
.claude/steps-results/
