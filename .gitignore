# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# Env
.env
.env.*
!.env.example

# Workspace content (keep dir, ignore generated files)
workspace/*
!workspace/.gitkeep

# Prompt logs (default under workspace/, but cover a custom PROMPT_LOG_DIR too)
prompt_logs/

# SQLite databases (local dev/test artifacts)
*.db

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Kilo local state (plans may contain secrets like API tokens)
.kilo/plans/
.kilo/worktrees/

# Cursor pipeline state (local orchestrator state, not shared via git)
.cursor/state/
.cursor/steps-results/
