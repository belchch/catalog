{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(pnpm run:*)",
      "Bash(curl:*)",
      "Bash(python3:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(date:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledPlugins": {
    "shift@belch": true
  }
}
