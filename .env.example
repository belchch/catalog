# Catalog — example environment configuration.
# Prefer backend/.env for local native runs (see README-RUN.md).
# Copy values you need into backend/.env (or a root .env for Docker/server experiments).

# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------
# Which provider the agent loop talks to. Built-in providers:
#   openrouter  (default; https://openrouter.ai)
#   zai         (Zhipu / BigModel GLM; https://api.z.ai — works without VPN)
# When unset, defaults to "openrouter" for backward compatibility.
APP_PROVIDER=openrouter

# ---------------------------------------------------------------------------
# OpenRouter (https://openrouter.ai)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free

# ---------------------------------------------------------------------------
# z.ai (Zhipu / BigModel, GLM) — OpenAI-compatible, usable without VPN.
# Create a key at https://z.ai. Only required when APP_PROVIDER=zai.
# General API:     https://api.z.ai/api/paas/v4
# Coding Plan key: https://api.z.ai/api/coding/paas/v4
# Model codes are bare GLM ids (glm-5.2, glm-4.7, …) — not "zai/…".
# ---------------------------------------------------------------------------
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ---------------------------------------------------------------------------
# Application paths & storage
# ---------------------------------------------------------------------------
# Documents live in a user-chosen workspace folder (opened in the UI),
# with business data at <folder>/.catalog/index.db — not under the repo.
#
# Global app DB / prompt logs default to the OS data dir
# (~/Library/Application Support/catalog on macOS, ~/.local/share/catalog else).
# Unset unless you need a custom location:
# APP_DATA_DIR=/absolute/path/to/data
#
# Point overrides (tests / advanced). Leave unset for product defaults:
# APP_DB_PATH=/absolute/path/to/app.db
# APP_WORKSPACE=/absolute/path/to/workspace
# APP_FS_ROOT=/absolute/path

# Logging — root level for the ``app`` logger hierarchy (default INFO).
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Prompt logging — raw request/response capture for quality analysis.
# Disabled by default; opt-in via PROMPT_LOG_ENABLED=1.
# ---------------------------------------------------------------------------
PROMPT_LOG_ENABLED=
PROMPT_LOG_DIR=
